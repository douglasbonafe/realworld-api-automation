<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.dsbon.realworld</groupId>
  <artifactId>realworld-api-automation</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>RealWorld API Automation</name>
  <description>
    The same API test suite implemented three times against api.realworld.show:
    plain java.net.http + TestNG, Spring Boot + JUnit + RestClient, and
    Spring Boot + REST Assured.
  </description>

  <!--
    A reactor, not a shared framework. Each module is deliberately
    self-contained — its own client, its own model types, its own assertions —
    because the point of the repository is to compare three stacks. Factoring
    the common parts into a shared module would erase exactly the differences
    the comparison exists to show.

    What the parent DOES own: the Java release, dependency versions, and the
    Surefire configuration, so that "same scenarios, same environment" is
    guaranteed by construction rather than by discipline.
  -->
  <modules>
    <module>testng-java-httpclient</module>
    <module>springboot-junit-restclient</module>
    <module>springboot-restassured</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <testng.version>7.12.0</testng.version>
    <rest-assured.version>6.0.1</rest-assured.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <jackson.version>2.22.2</jackson.version>
    <slf4j.version>2.0.18</slf4j.version>
    <surefire.version>3.5.6</surefire.version>

    <!--
      The target under test. Overridable per run:
        mvn test -Drealworld.base.url=http://localhost:8000/api

      Pointing at a self-hosted RealWorld backend is the supported way to run
      the full suite, including the scenarios the public sandbox cannot support.
      See docs/contract-findings.md.
    -->
    <realworld.base.url>https://api.realworld.show/api</realworld.base.url>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <!--
              PARALLELISM IS DELIBERATELY OFF, in every module.

              api.realworld.show keeps ONE global session: registering a user
              replaces the current identity for every caller, so two tests
              running at once will authenticate as each other. This is a
              property of the target, not a limitation of the frameworks — all
              three would parallelise happily against a self-hosted backend.

              Verified: register A, register B, then GET /user with A's token
              returns B. See docs/contract-findings.md, finding #1.
            -->
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
            <systemPropertyVariables>
              <realworld.base.url>${realworld.base.url}</realworld.base.url>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
